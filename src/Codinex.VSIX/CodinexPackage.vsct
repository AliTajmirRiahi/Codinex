<?xml version="1.0" encoding="utf-8"?>
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable" xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <Extern href="stdidcmd.h" />
  <Extern href="vsshlids.h" />

  <Commands package="guidCodinexPackage">

    <Menus>
      <Menu guid="guidCodinexPackageCmdSet" id="cmdidCodinexActionsMenu" priority="0x0500" type="Menu">
        <Parent guid="guidCodinexPackageCmdSet" id="cmdidCodinexActionsTopGroup" />
        <Icon guid="guidImages" id="bmpPic1" />
        <Strings>
          <ButtonText>Codinex Actions</ButtonText>
          <CommandName>Codinex Actions</CommandName>
        </Strings>
      </Menu>
    </Menus>

    <Groups>
      <Group guid="guidCodinexPackageCmdSet" id="cmdidCodinexActionsTopGroup" priority="0x0001">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_CTXT_CODEWIN" />
      </Group>
      <Group guid="guidCodinexPackageCmdSet" id="cmdidCodinexActionsGroup" priority="0x0100">
        <Parent guid="guidCodinexPackageCmdSet" id="cmdidCodinexActionsMenu" />
      </Group>
    </Groups>

    <Buttons>
      <Button guid="guidCodinexPackageCmdSet" id="cmdidCodinexToolWindowCommand" priority="0x0100" type="Button">
        <Parent guid="guidSHLMainMenu" id="IDG_VS_WNDO_OTRWNDWS1" />
        <Icon guid="guidImages" id="bmpPic1" />
        <Strings>
          <ButtonText>Codinex AI</ButtonText>
          <LocCanonicalName>.View.CodinexAI</LocCanonicalName>
        </Strings>
      </Button>

      <Button guid="guidCodinexPackageCmdSet" id="cmdidAddToChat" priority="0x0100" type="Button">
        <Parent guid="guidCodinexPackageCmdSet" id="cmdidCodinexActionsGroup" />
        <Strings>
          <ButtonText>Add to Chat</ButtonText>
          <CommandName>Add to Chat</CommandName>
        </Strings>
      </Button>

      <Button guid="guidCodinexPackageCmdSet" id="cmdidDescribeSelection" priority="0x0200" type="Button">
        <Parent guid="guidCodinexPackageCmdSet" id="cmdidCodinexActionsGroup" />
        <Strings>
          <ButtonText>Describe</ButtonText>
          <CommandName>Describe</CommandName>
        </Strings>
      </Button>
    </Buttons>

    <Bitmaps>
      <Bitmap guid="guidImages"
              href="Resources\Codinex.png"
              usedList="bmpPic1" />
    </Bitmaps>

  </Commands>

	<KeyBindings>
		<KeyBinding guid="guidCodinexPackageCmdSet"
            id="cmdidCodinexToolWindowCommand"
            editor="guidVSStd97"
            key1="I"
            mod1="Control Shift Alt" />
	</KeyBindings>

  <Symbols>
    <!-- ✅ This must match PackageGuidString in CodinexPackage.cs -->
    <GuidSymbol name="guidCodinexPackage" value="{eb873b7a-8287-48ac-8a6b-646d4166809b}" />

    <!-- ✅ This is the command set GUID — keep as is -->
    <GuidSymbol name="guidCodinexPackageCmdSet" value="{f695020e-3b35-40ae-b466-57fc5bbe2d6c}">
      <IDSymbol name="cmdidCodinexToolWindowCommand" value="0x0100" />
      <IDSymbol name="cmdidCodinexActionsTopGroup" value="0x010F" />
      <IDSymbol name="cmdidCodinexActionsMenu" value="0x0110" />
      <IDSymbol name="cmdidCodinexActionsGroup" value="0x0111" />
      <IDSymbol name="cmdidAddToChat" value="0x0112" />
      <IDSymbol name="cmdidDescribeSelection" value="0x0113" />
    </GuidSymbol>

    <!-- ✅ Icon GUID -->
    <GuidSymbol name="guidImages" value="{9aec0997-06e0-4254-ad9f-243180b4acdc}">
      <IDSymbol name="bmpPic1" value="1" />
    </GuidSymbol>

  </Symbols>

</CommandTable>